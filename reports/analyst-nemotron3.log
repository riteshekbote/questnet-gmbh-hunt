    <!-- Zuerst Help-spezifische CSS (höhere Spezifität im Container) -->
    <style id="help-css-wrapper">
        /* Lade Help CSS in einem isolierten Scope */
    </style>
    
    <script src="help/resources.help/codemirror/codemirror.min.js"></script>
    <script src="help/resources.help/codemirror/javascript.min.js"></script>

    <!-- Dann Page-Layout CSS (wirkt sich NICHT auf #HelpPanelContainer aus) -->
    <style>
        /* Verhindere dass Layout-CSS den Help-Container beeinflusst */
        body:not(#HelpPanelContainer) {
            /* Layout styles wirken nur außerhalb des Help-Containers */
        }
