import socket, ssl, base64, os, sys, time
host="cbs-proxy.api.live-manager.de"; port=443
cid=sys.argv[1]; token=sys.argv[2]
key=base64.b64encode(os.urandom(16)).decode()
path=f"/?origin=LiveDebugger&cid={cid}&service=100&token={token}"
req=(f"GET {path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\n"
     f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n")
ctx=ssl.create_default_context()
s=socket.create_connection((host,port),timeout=15)
ws=ctx.wrap_socket(s,server_hostname=host)
ws.sendall(req.encode())
# read response headers
data=b""
while b"\r\n\r\n" not in data:
    chunk=ws.recv(4096)
    if not chunk: break
    data+=chunk
head,rest=data.split(b"\r\n\r\n",1)
print("=== HTTP response (cid=%s) ==="%cid)
print(head.decode(errors="replace"))
# read a short window of raw server bytes (control frames only, no data subscription)
ws.settimeout(4)
buf=rest
end=time.time()+4
while time.time()<end:
    try:
        chunk=ws.recv(4096)
        if not chunk: break
        buf+=chunk
        if len(buf)>4096: break
    except socket.timeout:
        break
print("=== RAW BYTES (len=%d) ==="%len(buf))
print(buf.hex())
ws.close()
EOF
